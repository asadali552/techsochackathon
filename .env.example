# Browser-visible API base URL. Vite exposes only VITE_ variables.
VITE_API_URL=http://localhost:8000

# Browser sign-in. Use the same project URL and publishable (or legacy anon) key as the server.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional map tile provider. Leave blank to use OpenStreetMap with its built-in attribution.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=

# JSON list of exact frontend origins.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Phase 1 Auth. Use the project URL and a publishable (or legacy anon) key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only. Leave empty unless a reviewed integration requires it.
SUPABASE_SERVICE_ROLE_KEY=
# PostgreSQL direct or session-pooler connection URI. Server only. Use TLS for hosted Supabase.
DATABASE_URL=

# Server-only AI configuration. Leaving the key or model blank disables provider calls.
# Use openai, or openai_compatible with a Chat Completions API base URL ending in /v1.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=8
# JSON array of trusted moderator Supabase Auth user UUIDs.
LLM_MODERATOR_IDS=[]

# OSRM-compatible driving service base URL. Use https://routing.openstreetmap.de/routed-car for low-volume demos.
ROUTING_SERVICE_URL=

# Phase 3 scoring and grid defaults.
HEATMAP_TIMEZONE=Asia/Karachi
HEATMAP_CELL_SIZE=750
HEATMAP_MIN_REPORTS=2
HEATMAP_MODERATE_THRESHOLD=25
HEATMAP_ELEVATED_THRESHOLD=60

# Browser-only heatmap display scale and spatial radius (in grid cells).
VITE_HEATMAP_DISPLAY_BREAKS=20,40,60,80
VITE_HEATMAP_KERNEL_RADIUS=1.15

# Gemini takes priority for the travel assistant when its server-side key is set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Allow unsigned demo visitors to use the Gemini quota. Keep off for public demos.
ASSISTANT_GEMINI_IN_DEMO=false
ASSISTANT_TIMEOUT_SECONDS=5
ASSISTANT_MAX_OUTPUT_TOKENS=650
# Optional private or contracted Nominatim-compatible base URL for place lookup.
# Leave blank to use the bundled landmarks and explicit coordinates.
GEOCODING_SERVICE_URL=
